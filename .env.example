# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Providers (at least one required; pick models to match) ---
# Free: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza-your-google-ai-studio-key-here
# Optional paid fallback:
OPENAI_API_KEY=sk-your-openai-api-key-here

# Public origin for sitemap absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Model ids — gemini-* → Google; gpt-*/o* → OpenAI
# Try first: gemini-3.5-flash | High-volume: gemini-3.5-flash-lite
# Architectural expand: gemini-3.1-pro-preview
DEFAULT_MODEL=gemini-3.5-flash
EXPANSION_MODEL=gemini-3.1-pro-preview

# Optional force: openai | google (normally inferred from model id)
# AI_PROVIDER=
